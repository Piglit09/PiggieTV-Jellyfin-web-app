{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piggietv.com/contracts/ptv-core/v1/recommendation-item.schema.json",
  "title": "PTV Recommendation Item v1",
  "type": "object",
  "required": ["id", "title", "mediaType", "score", "source", "classification", "reasons"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "mediaType": {
      "enum": [
        "movie",
        "show",
        "season",
        "episode",
        "music",
        "album",
        "artist",
        "playlist",
        "book",
        "comic",
        "manga",
        "audiobook",
        "live-tv",
        "game",
        "unknown"
      ]
    },
    "score": { "type": "number" },
    "source": { "type": "string", "minLength": 1, "maxLength": 120 },
    "classification": { "enum": ["affinity", "discovery", "mixed"] },
    "reasons": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "code": { "type": "string", "maxLength": 96 },
          "score": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "artwork": {
      "type": "object",
      "properties": {
        "mediaId": { "type": "string", "minLength": 1 },
        "imageType": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "index": { "type": "integer", "minimum": 0 },
        "aspectRatio": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "debug": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
