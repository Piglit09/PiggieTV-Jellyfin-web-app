{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piggietv.local/ptv-core/v1/diagnostic-snapshot.schema.json",
  "title": "PTV diagnostic snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contractVersion",
    "schemaVersion",
    "generatedAt",
    "diagnosticSessionId",
    "privacyClassification",
    "health",
    "build",
    "platform",
    "core",
    "server",
    "plugin",
    "focusChanges",
    "focusGraphs",
    "focusScopes",
    "focusVisibility",
    "requests",
    "routes",
    "frames",
    "latestFocus",
    "inputs",
    "images",
    "shelves",
    "cache",
    "recommendations",
    "collectorCapabilities",
    "droppedEvents",
    "retentionLimits",
    "session",
    "self",
    "warnings"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "diagnosticSessionId": {
      "type": "string",
      "minLength": 1
    },
    "privacyClassification": {
      "enum": [
        "local-only",
        "share-safe"
      ]
    },
    "health": {
      "$ref": "#/$defs/health"
    },
    "build": {
      "type": "object",
      "additionalProperties": true
    },
    "platform": {
      "type": "object",
      "additionalProperties": true
    },
    "playbackSessions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/playbackSession"
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": true
    },
    "server": {
      "type": "object",
      "additionalProperties": true
    },
    "plugin": {
      "type": "object",
      "additionalProperties": true
    },
    "focusChanges": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "focusGraphs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "focusScopes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "focusVisibility": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "latestFocus": {
      "type": "object",
      "additionalProperties": true
    },
    "inputs": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "shelves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": true
    },
    "recommendations": {
      "type": "object",
      "additionalProperties": true
    },
    "collectorCapabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "droppedEvents": {
      "type": "object",
      "required": [
        "byStream",
        "total"
      ],
      "properties": {
        "byStream": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "retentionLimits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": true
    },
    "self": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "playbackSession": {
      "type": "object",
      "required": [
        "diagnosticSessionId",
        "updatedAt",
        "sourceGeneration",
        "terminal",
        "state",
        "mediaMode",
        "routeClassification",
        "routeFamily",
        "buffer",
        "stalls",
        "hls",
        "player",
        "readyStateTransitions"
      ],
      "properties": {
        "diagnosticSessionId": {
          "type": "string",
          "pattern": "^(?:ptv-)?playback(?:-session)?-[a-z0-9][a-z0-9-]{0,63}$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "terminal": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "IDLE",
            "LOADING",
            "BUFFERING",
            "PLAYING",
            "DEGRADED",
            "STALLED",
            "RECOVERING",
            "ENDED",
            "FAILED"
          ]
        },
        "mediaMode": {
          "enum": [
            "Direct Play",
            "Direct Stream",
            "HLS Transcode",
            "Unknown"
          ]
        },
        "routeClassification": {
          "enum": [
            "LAN_DIRECT",
            "LOCAL_VIA_PUBLIC_HOSTNAME",
            "PUBLIC_PROXY",
            "CLOUDFLARE_TUNNEL",
            "VPN_PATH",
            "UNKNOWN"
          ]
        },
        "routeFamily": {
          "enum": [
            "audio",
            "books",
            "collections",
            "comics",
            "details",
            "full-screen-player",
            "home",
            "item",
            "live-tv",
            "manga",
            "mini-player",
            "movies",
            "music",
            "now-playing",
            "other",
            "playback",
            "player",
            "reading",
            "search",
            "shows",
            "tv",
            "unknown",
            "video"
          ]
        },
        "buffer": {
          "type": "object",
          "required": [
            "currentAheadSeconds",
            "minimumAheadSeconds",
            "maximumAheadSeconds",
            "averageAheadSeconds",
            "sampleCount",
            "belowTwoSecondsCount",
            "zeroBufferCount"
          ],
          "properties": {
            "currentAheadSeconds": { "type": "number", "minimum": 0 },
            "minimumAheadSeconds": { "type": "number", "minimum": 0 },
            "maximumAheadSeconds": { "type": "number", "minimum": 0 },
            "averageAheadSeconds": { "type": "number", "minimum": 0 },
            "sampleCount": { "type": "integer", "minimum": 0 },
            "belowTwoSecondsCount": { "type": "integer", "minimum": 0 },
            "zeroBufferCount": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "stalls": {
          "type": "object",
          "required": [
            "waitingCount",
            "stalledCount",
            "episodeDurationsMs",
            "cumulativeDurationMs",
            "longestDurationMs",
            "recoveryResults"
          ],
          "properties": {
            "waitingCount": { "type": "integer", "minimum": 0 },
            "stalledCount": { "type": "integer", "minimum": 0 },
            "episodeDurationsMs": {
              "type": "array",
              "maxItems": 20,
              "items": { "type": "number", "minimum": 0 }
            },
            "cumulativeDurationMs": { "type": "number", "minimum": 0 },
            "longestDurationMs": { "type": "number", "minimum": 0 },
            "recoveryResults": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "enum": [
                  "cancelled",
                  "failed",
                  "ignored",
                  "load-restarted",
                  "media-error-recovered",
                  "not-attempted",
                  "not-needed",
                  "recovered",
                  "retrying",
                  "skipped",
                  "source-replaced",
                  "stale",
                  "success",
                  "succeeded",
                  "suppressed",
                  "timed-out",
                  "timeout",
                  "unknown"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "hls": {
          "type": "object",
          "required": [
            "manifestRequestCount",
            "manifestSuccessCount",
            "manifestAverageLatencyMs",
            "manifestP95LatencyMs",
            "fragmentRequestCount",
            "fragmentSuccessCount",
            "fragmentFailureCount",
            "fragmentTimeoutCount",
            "fragmentRetryCount",
            "duplicateFragmentRequestCount",
            "fragmentAverageLatencyMs",
            "fragmentP95LatencyMs",
            "fragmentLongestLatencyMs",
            "droppedFragmentTrackingCount"
          ],
          "properties": {
            "manifestRequestCount": { "type": "integer", "minimum": 0 },
            "manifestSuccessCount": { "type": "integer", "minimum": 0 },
            "manifestAverageLatencyMs": { "type": "number", "minimum": 0 },
            "manifestP95LatencyMs": { "type": "number", "minimum": 0 },
            "fragmentRequestCount": { "type": "integer", "minimum": 0 },
            "fragmentSuccessCount": { "type": "integer", "minimum": 0 },
            "fragmentFailureCount": { "type": "integer", "minimum": 0 },
            "fragmentTimeoutCount": { "type": "integer", "minimum": 0 },
            "fragmentRetryCount": { "type": "integer", "minimum": 0 },
            "duplicateFragmentRequestCount": { "type": "integer", "minimum": 0 },
            "fragmentAverageLatencyMs": { "type": "number", "minimum": 0 },
            "fragmentP95LatencyMs": { "type": "number", "minimum": 0 },
            "fragmentLongestLatencyMs": { "type": "number", "minimum": 0 },
            "droppedFragmentTrackingCount": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "player": {
          "type": "object",
          "required": [
            "mediaSourceAssignments",
            "sourceReplacements",
            "mountCount",
            "unmountCount",
            "playCalls",
            "pauseCalls",
            "programmaticSeeks",
            "qualitySwitches",
            "recoveryActions",
            "activeLoadRestarts",
            "staleEventsIgnored"
          ],
          "properties": {
            "mediaSourceAssignments": { "type": "integer", "minimum": 0 },
            "sourceReplacements": { "type": "integer", "minimum": 0 },
            "mountCount": { "type": "integer", "minimum": 0 },
            "unmountCount": { "type": "integer", "minimum": 0 },
            "playCalls": { "type": "integer", "minimum": 0 },
            "pauseCalls": { "type": "integer", "minimum": 0 },
            "programmaticSeeks": { "type": "integer", "minimum": 0 },
            "qualitySwitches": { "type": "integer", "minimum": 0 },
            "recoveryActions": { "type": "integer", "minimum": 0 },
            "activeLoadRestarts": { "type": "integer", "minimum": 0 },
            "staleEventsIgnored": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "readyStateTransitions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "atMs"
            ],
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "to": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "atMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "lastUpdated",
        "metrics",
        "warnings",
        "collectorAvailable"
      ],
      "properties": {
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "failing",
            "unavailable",
            "unsupported",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "number",
              "string",
              "null"
            ]
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collectorAvailable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
