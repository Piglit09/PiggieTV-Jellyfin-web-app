{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piggietv.local/ptv-core/v1/diagnostic-snapshot.schema.json",
  "title": "PTV diagnostic snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contractVersion",
    "schemaVersion",
    "generatedAt",
    "diagnosticSessionId",
    "privacyClassification",
    "health",
    "build",
    "platform",
    "core",
    "server",
    "plugin",
    "focusChanges",
    "focusGraphs",
    "focusScopes",
    "focusVisibility",
    "requests",
    "routes",
    "frames",
    "latestFocus",
    "inputs",
    "images",
    "shelves",
    "cache",
    "recommendations",
    "collectorCapabilities",
    "droppedEvents",
    "retentionLimits",
    "session",
    "self",
    "warnings"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "diagnosticSessionId": {
      "type": "string",
      "minLength": 1
    },
    "privacyClassification": {
      "enum": [
        "local-only",
        "share-safe"
      ]
    },
    "health": {
      "$ref": "#/$defs/health"
    },
    "build": {
      "type": "object",
      "additionalProperties": true
    },
    "platform": {
      "type": "object",
      "additionalProperties": true
    },
    "core": {
      "type": "object",
      "additionalProperties": true
    },
    "server": {
      "type": "object",
      "additionalProperties": true
    },
    "plugin": {
      "type": "object",
      "additionalProperties": true
    },
    "focusChanges": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "focusGraphs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "focusScopes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "focusVisibility": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "latestFocus": {
      "type": "object",
      "additionalProperties": true
    },
    "inputs": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "shelves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": true
    },
    "recommendations": {
      "type": "object",
      "additionalProperties": true
    },
    "collectorCapabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "droppedEvents": {
      "type": "object",
      "required": [
        "byStream",
        "total"
      ],
      "properties": {
        "byStream": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "retentionLimits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": true
    },
    "self": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "health": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "lastUpdated",
        "metrics",
        "warnings",
        "collectorAvailable"
      ],
      "properties": {
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "failing",
            "unavailable",
            "unsupported",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "number",
              "string",
              "null"
            ]
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collectorAvailable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
