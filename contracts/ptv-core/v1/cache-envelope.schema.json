{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piggietv.com/contracts/ptv-core/v1/cache-envelope.schema.json",
  "title": "PTV Cache Envelope v1",
  "type": "object",
  "required": [
    "contractVersion",
    "schemaVersion",
    "key",
    "scope",
    "createdAt",
    "expiresAt",
    "payload"
  ],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "key": { "type": "string", "minLength": 1, "maxLength": 500 },
    "scope": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["global", "user", "server", "device"] },
        "serverId": { "type": "string", "minLength": 1 },
        "userId": { "type": "string", "minLength": 1 },
        "deviceId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "staleWhileRevalidateUntil": { "type": "string", "format": "date-time" },
    "payloadBytes": { "type": "integer", "minimum": 0 },
    "payload": true
  },
  "additionalProperties": true
}
